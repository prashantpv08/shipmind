{
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint .",
    "architecture:check": "node --import tsx scripts/check-architecture-boundaries.ts",
    "contracts:sync": "node --import tsx scripts/sync-platform-openapi.ts",
    "contracts:generate": "node --import tsx scripts/generate-platform-client.ts",
    "contracts:check": "node --import tsx scripts/check-generated-platform-client.ts",
    "security:audit": "pnpm audit --prod --audit-level moderate && pnpm audit --audit-level high",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:applicability": "node --import tsx scripts/run-applicability-e2e.ts",
    "build": "next build --webpack",
    "demo:reset": "node scripts/demo-reset.mjs",
    "sandbox:build": "tsc -p sandbox/notification-service/workspace/tsconfig.json --noEmit",
    "sandbox:test:unit": "vitest run --config sandbox/notification-service/workspace/vitest.config.ts sandbox/notification-service/workspace/tests/notification-service.unit.test.ts",
    "sandbox:test:api": "vitest run --config sandbox/notification-service/workspace/vitest.config.ts sandbox/notification-service/workspace/tests/notification-service.api.test.ts",
    "sandbox:test": "vitest run --config sandbox/notification-service/workspace/vitest.config.ts sandbox/notification-service/workspace/tests",
    "sandbox:coverage": "vitest run --config sandbox/notification-service/workspace/vitest.config.ts sandbox/notification-service/workspace/tests --coverage.enabled=true --coverage.provider=v8 --coverage.reporter=json-summary --coverage.reporter=text --coverage.reportsDirectory=sandbox/notification-service/workspace/coverage",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --import tsx scripts/db-seed.ts",
    "db:reset": "node --import tsx scripts/db-reset.ts",
    "db:test": "TEST_DATABASE_URL=postgresql://axiom:axiom-local-only@localhost:54329/axiom_test vitest run tests/postgres.integration.test.ts",
    "db:import:dry-run": "node --import tsx scripts/import-prototype-data.ts --dry-run",
    "db:import": "node --import tsx scripts/import-prototype-data.ts --apply",
    "db:verify-import": "node --import tsx scripts/verify-prototype-import.ts"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@vercel/blob": "^2.6.1",
    "@vitejs/plugin-react": "6.0.3",
    "drizzle-orm": "^0.45.2",
    "mammoth": "1.12.0",
    "mermaid": "11.16.1",
    "next": "16.2.11",
    "pg": "^8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "unpdf": "1.6.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "autoprefixer": "10.5.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "jsdom": "29.1.1",
    "postcss": "8.5.23",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
      "dompurify@>=3.0.0 <=3.4.12": "3.4.13",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "lodash-es@>=4.0.0 <=4.17.23": "4.18.1",
      "nanoid@<3.3.17": "3.3.17",
      "nanoid@>=4.0.0 <5.1.16": "5.1.16",
      "postcss@<=8.5.22": "8.5.23",
      "sharp@<0.35.0": "0.35.0",
      "undici@>=6.0.0 <6.28.0": "6.28.0",
      "undici@>=7.0.0 <7.29.0": "7.29.0"
    }
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.0.0"
  }
}
